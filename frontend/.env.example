# Variabel lingkungan CMS (frontend). Salin sebagai `frontend/.env`.
# Isi di bawah ini dibaca Vite lewat `import.meta.env.VITE_*` — semua opsional.

# Pilihan sumber data: local | supabase | firebase.
# Kosongkan untuk pilihan otomatis: Supabase bila kuncinya lengkap, lalu Firebase,
# lalu local.
VITE_DATA_SOURCE=

# Mode local (pratinjau saja): kata sandi admin, default "admin".
# Perhatian: sandi ini cuma dibandingkan di peramban, BUKAN keamanan sungguhan.
VITE_ADMIN_PASSWORD=

# Supabase: isi URL proyek dan anon key dari project settings.
# Aktifkan provider Email di Authentication dan buat pengguna, lalu jalankan supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase: isi Web API key dan ID proyek.
# Aktifkan email/password di Authentication dan pasang firebase/firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=