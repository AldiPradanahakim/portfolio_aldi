# Environment Variables
# Salin berkas ini menjadi .env lalu isi nilainya. Jangan pernah commit .env.

PORT=3001

# Email pengirim (Gmail). EMAIL_PASSWORD adalah App Password 16 karakter
# yang dibuat di https://myaccount.google.com/apppasswords — bukan kata sandi
# akun Google. Buang spasi saat menempelkannya.
EMAIL_USER=alamat@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=alamat@gmail.com
